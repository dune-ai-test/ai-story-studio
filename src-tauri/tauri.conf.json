{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Story Writing Studio",
  "version": "0.1.0",
  "identifier": "studio.storywrite.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Story Writing Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": {
      "msi": { "version": "0.1.0" },
      "exe": {}
    }
  }
}